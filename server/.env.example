SADO_ENVIRONMENT=development

# Preferred voice: OmniVoice on the GPU. MMS-TTS takes over if it fails.
SADO_USE_OMNIVOICE=true
SADO_OMNIVOICE_DEVICE=cuda
SADO_OMNIVOICE_UZBEK_CODE=uz
SADO_DEFAULT_VOICE=sado

# Fallback voice: MMS-TTS. Lower rhythm variation gives an even, steady tempo.
SADO_MMS_DEVICE=cpu
SADO_VOICE_SPEAKING_RATE=1.0
SADO_VOICE_PITCH_VARIATION=0.5
SADO_VOICE_RHYTHM_VARIATION=0.0

# Mood reference clips live here (build them with scripts/build_mood_references.py).
SADO_MOOD_REFERENCE_DIR=data/voices
SADO_CLONE_NUM_STEPS=64
SADO_CLONE_GUIDANCE_SCALE=3.0

# Speech recognition worker (workers/omnilingual_asr_worker.py, runs on Linux/WSL).
SADO_ASR_URL=http://localhost:8011
SADO_ASR_TIMEOUT_SECONDS=20

# Saved memories (SQLite, created on first run).
SADO_MEMORY_DB_PATH=data/memory.sqlite3

# Reasoning: Meta Muse Spark through the Model API. Create a key at dev.meta.ai -> API keys.
SADO_META_API_KEY=
SADO_META_API_URL=https://api.meta.ai/v1

# Muse Spark Open on Baseten listens when the Omnilingual worker is away (no GPU needed).
SADO_BASETEN_API_KEY=
SADO_REASONING_MODEL=muse-spark-1.3
SADO_REASONING_EFFORT=low
SADO_REASONING_TIMEOUT_SECONDS=25

# Let Sado see and control this Windows computer (needs `uv sync --extra desktop`).
# Reading windows is free; typing, closing and running commands always wait for your yes.
SADO_DESKTOP_CONTROL=false
# Required with desktop control. Give the same value to the desktop app with
# --dart-define=SADO_DESKTOP_TOKEN=... ; phones without it can never drive the computer.
SADO_DESKTOP_TOKEN=
# Devices without the token are guests with their own memory, kept here.
SADO_GUEST_DB_PATH=data/guests.sqlite3

# Sign-in with Google (Firebase). Everyone who signs in gets their own memory; a phone
# signed in with one of the owner's addresses may also drive the computer.
SADO_FIREBASE_PROJECT_ID=
SADO_OWNER_EMAILS=
