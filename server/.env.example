SADO_ENVIRONMENT=development

# Preferred voice: OmniVoice on the GPU. MMS-TTS takes over if it fails.
SADO_USE_OMNIVOICE=true
SADO_OMNIVOICE_DEVICE=cuda
SADO_OMNIVOICE_UZBEK_CODE=uz
SADO_VOICE_DESCRIPTION=male, moderate pitch

# Fallback voice: MMS-TTS. Lower rhythm variation gives an even, steady tempo.
SADO_MMS_DEVICE=cpu
SADO_VOICE_SPEAKING_RATE=1.0
SADO_VOICE_PITCH_VARIATION=0.5
SADO_VOICE_RHYTHM_VARIATION=0.0
